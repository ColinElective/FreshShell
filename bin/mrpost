#!/bin/bash
#
# mrpost - build the code-review message for the review channel.
#
# Lists your open, non-draft merge requests in the current repo via glab, aged
# from when each became reviewable rather than when it was opened,
# oldest first, and prints them as plain text ready to paste. No markup: the
# chat composer does not interpret it, so asterisks would show up literally.
#
# Every generated message is also saved to $MRPOST_DIR, which defaults to
# .mrpost at the repository root.
# Those saved copies are the record of what has already been posted: each run
# is assumed to end up in the channel, so one history file is one post. That
# is what lets a later run say how many times an MR has been chased already.

set -uo pipefail

usage() {
  cat <<'USAGE'
Usage: mrpost [options]

  -a, --author <username>  GitLab author to query (default: $MRPOST_AUTHOR,
                           else the user glab is authenticated as)
  -c, --copy               Copy the message to the clipboard (pbcopy). On by
                           default; use --no-copy to turn it off.
      --no-copy            Print the message without touching the clipboard.
      --pc, --post-count   Add "- Posted here N times" to each MR, counted
                           from past messages. Off by default.
  -p, --prev               Reprint the most recent saved message and copy it,
                           without contacting GitLab at all. For when the last
                           one was generated but never actually posted.
  -y, --yes                Include every MR without asking, even ones that
                           already have review comments.
  -h, --help               Show this help.

Environment:
  MRPOST_AUTHOR            GitLab username to query.
  MRPOST_NOTICE_MARKER     Any comment whose body contains this never counts
                           as a review (default: NX_CLOUD_APP_COMMENT_END,
                           the marker Nx Cloud signs its CI summary with).
                           Blank it to disable the rule.
  MRPOST_IGNORE_COMMENTERS Comma-separated usernames whose comments never
                           count as a review (default: ghost1, the account
                           CodeRabbit and Linear post under).
  MRPOST_DIR               Where to keep past messages (default: .mrpost at
                           the repository root).
                           Each run saves a copy there, and every saved copy
                           counts as one post to the channel.
USAGE
}

author=""
copy="true"
assume_yes=""
show_post_count=""
use_previous=""
ignore_commenters="${MRPOST_IGNORE_COMMENTERS-ghost1}"
# Nx Cloud posts its CI summary under a real person's account, so it cannot be
# filtered by username. It signs the body with this HTML marker, which is a
# surer match than the visible text - that can be reworded, the marker cannot.
notice_marker="${MRPOST_NOTICE_MARKER-NX_CLOUD_APP_COMMENT_END}"
history_dir="${MRPOST_DIR:-}"
history_ext=".txt"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--author)  author="${2:-}"; shift 2 ;;
    -c|--copy)    copy="true"; shift ;;
    --no-copy)    copy=""; shift ;;
    -y|--yes)     assume_yes="true"; shift ;;
    -pc|--pc|--post-count) show_post_count="true"; shift ;;
    -p|--prev)    use_previous="true"; shift ;;
    -h|--help)    usage; exit 0 ;;
    *)            echo "Unexpected argument: $1" >&2; usage >&2; exit 1 ;;
  esac
done

# Colors are empty unless stderr is a terminal, so every call site stays the
# same shape and the codes simply vanish when output is redirected or piped.
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  clr_cyan=$'\033[36m'
  clr_dim=$'\033[2m'
  clr_yellow=$'\033[33m'
  clr_red=$'\033[31m'
  clr_reset=$'\033[0m'
else
  clr_cyan="" clr_dim="" clr_yellow="" clr_red="" clr_reset=""
fi

# One line of colored text on stderr. printf, not echo: the text is data and
# belongs in an argument, never in the format string.
line_in() {
  local color="$1"
  shift
  printf '%s%s%s\n' "$color" "$*" "$clr_reset" >&2
}

line_cyan()   { line_in "$clr_cyan"   "$@"; }
line_dim()    { line_in "$clr_dim"    "$@"; }
line_yellow() { line_in "$clr_yellow" "$@"; }
line_red()    { line_in "$clr_red"    "$@"; }

# Progress notices go to stderr, and only to a terminal: stdout has to stay
# clean for a pipe, and a log file should not collect half-drawn lines. Each
# notice overwrites the one before it and the last is erased, so the finished
# run leaves no trace of them behind.
progress() {
  [ -t 2 ] || return 0
  printf '\r\033[K%s' "$*" >&2
}

progress_clear() {
  [ -t 2 ] || return 0
  printf '\r\033[K' >&2
}

# The most recently written history file, or nothing on a first run. The
# timestamp format sorts chronologically, so plain lexical order is enough.
latest_history() {
  ls -1 "$history_dir"/*"$history_ext" 2>/dev/null | sort | tail -n 1
}

# 2026-08-31-142530.txt -> 2026-08-31 14:25. Read from the name rather than the
# mtime so that copying or restoring the directory does not rewrite history.
history_date() {
  local base
  base=$(basename "$1" "$history_ext")
  if [[ "$base" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})-([0-9]{2})([0-9]{2})[0-9]{2}$ ]]; then
    echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}:${BASH_REMATCH[3]}"
  else
    echo "$base"
  fi
}

# Deliver the finished message to the clipboard, if that is switched on.
copy_to_clipboard() {
  [ -n "$copy" ] || return 0
  command -v pbcopy >/dev/null 2>&1 || return 0
  printf '%s\n' "$1" | pbcopy
  echo >&2
  line_cyan "Copied to clipboard."
}

# --prev only reads a file back, so it needs neither of these.
if [ -z "$use_previous" ]; then
  for cmd in glab jq; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "$cmd is required but not installed." >&2; exit 1; }
  done
fi

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
  echo "Not inside a Git repository." >&2
  exit 1
fi

# Anchor the history to the repo root, not the working directory. Running from
# the root and from a subdirectory of a monorepo would otherwise build two
# separate histories that cannot see each other, silently undercounting.
if [ -z "$history_dir" ]; then
  history_dir="$(git rev-parse --show-toplevel)/.mrpost"
fi

# --- Reuse the last message -------------------------------------------------
# Deliberately before anything that talks to GitLab: the whole point is to
# recover a message that was generated but never posted, without paying for the
# lookups again. Nothing is recorded either - that run already counted as a
# post, and this is the same message finally reaching the channel.
if [ -n "$use_previous" ]; then
  previous=$(latest_history)
  if [ -z "$previous" ] || [ ! -r "$previous" ]; then
    echo "No saved message to reuse in $history_dir." >&2
    exit 1
  fi

  echo "Reusing the message from $(history_date "$previous")." >&2
  previous_message=$(cat "$previous")
  printf '%s\n' "$previous_message"
  copy_to_clipboard "$previous_message"
  exit 0
fi

# --- Who are we asking about? ----------------------------------------------
# glab resolves @me for assignee/reviewer but not reliably for --author, so
# look the username up explicitly.
if [ -z "$author" ]; then
  author="${MRPOST_AUTHOR:-}"
fi
if [ -z "$author" ]; then
  author=$(glab api user 2>/dev/null | jq -r '.username // empty')
fi
if [ -z "$author" ]; then
  echo "Could not determine a GitLab author. Set MRPOST_AUTHOR or run 'glab auth login'." >&2
  exit 1
fi

# --- Fetch everything -------------------------------------------------------
# One GraphQL request carries the whole job: every open non-draft MR of yours,
# each with its approvals and its full note list. The REST version needed a
# list call plus two calls per MR, so this is 2N+1 round trips collapsed to 1.
#
# The project path is derived from the git remote rather than looked up, so
# that stays true - both the SSH and HTTPS remote forms reduce to group/repo.
project_path=$(git remote get-url origin 2>/dev/null \
  | sed -e 's#^git@[^:]*:##' -e 's#^https\{0,1\}://[^/]*/##' -e 's#\.git$##')
if [ -z "$project_path" ]; then
  echo "Could not work out the GitLab project from the 'origin' remote." >&2
  exit 1
fi

progress "Fetching MRs..."
graph_json=$(glab api graphql -f query="
{
  project(fullPath: \"$project_path\") {
    mergeRequests(authorUsername: \"$author\", state: opened, draft: false, first: 100) {
      nodes {
        iid title webUrl createdAt draft conflicts
        approvedBy { nodes { username } }
        notes(first: 100) {
          pageInfo { hasNextPage endCursor }
          nodes { body system createdAt author { username } }
        }
      }
    }
  }
}" 2>/dev/null)
progress_clear

if ! jq -e '.data.project.mergeRequests.nodes | type == "array"' <<<"${graph_json:-null}" >/dev/null 2>&1; then
  echo "Could not fetch merge requests for '$author' in $project_path." >&2
  jq -r '.errors[]?.message | "  " + .' <<<"${graph_json:-null}" 2>/dev/null >&2
  exit 1
fi

# --- Fetch the rest of any long note list -----------------------------------
# Notes come 100 to a page, and everything below reads them: the ready date,
# the approval and its reset, the review comments. A busy MR can outgrow one
# page, so any MR with more is paged through here, one request per extra page,
# and the notes folded into graph_json as if the first request had got them.
# Only the rare long MR pays for this.
#
# The page is handed to jq through a file rather than an argument: a hundred
# notes, CI summaries among them, can run past the argument length limit.
fetch_remaining_notes() {
  local iid="$1" cursor="$2" page

  while [ -n "$cursor" ]; do
    progress "Fetching more notes for !${iid}..."
    page=$(glab api graphql -f query="
{
  project(fullPath: \"$project_path\") {
    mergeRequest(iid: \"$iid\") {
      notes(first: 100, after: \"$cursor\") {
        pageInfo { hasNextPage endCursor }
        nodes { body system createdAt author { username } }
      }
    }
  }
}" 2>/dev/null)

    if ! jq -e '.data.project.mergeRequest.notes.nodes | type == "array"' <<<"${page:-null}" >/dev/null 2>&1; then
      progress_clear
      line_yellow "Could not fetch every note for !${iid} - its review comments and approvals may be incomplete."
      return 1
    fi

    graph_json=$(jq --arg iid "$iid" --slurpfile page <(printf '%s' "$page") '
      $page[0].data.project.mergeRequest.notes as $more
      | .data.project.mergeRequests.nodes |= map(
          if .iid == $iid then .notes.nodes += $more.nodes else . end)
    ' <<<"$graph_json")

    cursor=$(jq -r '.data.project.mergeRequest.notes.pageInfo
                    | if .hasNextPage then .endCursor else empty end' <<<"$page")
  done
  progress_clear
}

while IFS=$'\t' read -r iid cursor; do
  [ -n "$iid" ] || continue
  fetch_remaining_notes "$iid" "$cursor"
done < <(jq -r '.data.project.mergeRequests.nodes[]
                | select(.notes.pageInfo.hasNextPage == true)
                | [.iid, .notes.pageInfo.endCursor] | @tsv' <<<"$graph_json")

# Everything the loop needs, derived in a single pass: when each MR became
# reviewable, who approved it, and who left a real review comment. Doing it
# here rather than per-MR means the loop makes no calls of its own at all.
#
# Ordered by ready date, so whatever has been waiting longest leads the message.
#
# Fields are separated by 0x1F rather than by the tab @tsv emits. Tab is an IFS
# *whitespace* character, so `read` folds a run of them into one delimiter and
# an empty field silently vanishes, shifting every later column left. An MR
# with no approvals but real comments hit exactly that. 0x1F is not whitespace,
# so empty fields survive; @tsv has already escaped any literal tab or newline
# in the data, which is what makes the translation safe.
rows=$(jq -r --arg author "$author" --arg ignore "$ignore_commenters" \
              --arg marker "$notice_marker" '
  def names($who):
    ($who | unique | map("@" + .)) as $n
    | if ($n | length) <= 3 then ($n | join(", "))
      else (($n[0:2] | join(", ")) + " and \(($n | length) - 2) others") end;

  ($ignore | split(",") | map(select(length > 0))) as $bots
  | .data.project.mergeRequests.nodes
  | map(select(.draft != true))
  | map(. as $mr
    | [ $mr.notes.nodes[]? | select(.system == true) ] as $sys

    # What counts as someone having actually reviewed it: not system notes,
    # not the Nx Cloud summary (found by the marker it signs its body with),
    # not the integration accounts, and not your own comments.
    | [ $mr.notes.nodes[]?
        | select(.system != true)
        | select(($marker == "") or (((.body // "") | contains($marker)) | not)) ] as $human
    | [ $human[] | . as $n | $n.author.username as $u
        | select($u != $author and (($bots | index($u)) == null)) | $n ] as $reviews

    # The newest approval on record, whether or not it still stands, and the
    # newest review comment. Whichever is later is the last review round.
    | ([ $sys[] | select(.body | test("^approved this merge request"; "i")) ]
       | sort_by(.createdAt) | last) as $approval
    | ([ $reviews[].createdAt ] | sort | last) as $commented
    | (if $approval != null and ($commented == null or $approval.createdAt >= $commented)
       then "approved" elif $commented != null then "commented" else "" end) as $kind
    | (if $kind == "approved" then $approval.createdAt else $commented end) as $reviewed

    | {
      iid: $mr.iid, title: $mr.title, webUrl: $mr.webUrl,
      conflicts: $mr.conflicts,
      reviewed_kind: $kind,
      reviewed_at: ($reviewed // ""),
      reviewers: (if $kind == "approved" then [ $approval.author.username ]
                  else [ $reviews[].author.username ] end),

      # Reviewed once and since answered, so it wants another look, aged from
      # the first answer. After review comments only a push counts: a reply
      # alone usually means the work is still to do, and posting it would get
      # an "I already reviewed that". After an approval, a push, a revoke or a
      # reset note does. A standing approval never gets here, since approved
      # MRs are dropped. One whose approval has gone with no note to say why
      # is dated from the approval itself, which is the best date there is;
      # not every GitLab version writes the reset note. Comments with no push
      # since leave this empty: the next move is yours, so the loop asks.
      rereview_at: (if $kind == "" then "" else
                      (if $kind == "commented" then "^added [0-9]+ commits?"
                       else "^added [0-9]+ commits?|^unapproved this merge request|^reset approvals" end) as $answer
                      | ([ $sys[] | select(.body | test($answer; "i"))
                                  | .createdAt | select(. > $reviewed) ] | sort | first)
                        // (if $kind == "approved" and ($mr.approvedBy.nodes | length) == 0
                            then $reviewed else "" end)
                    end),

      # The draft/ready flip is a system note. Newest wins - an MR can be
      # flipped more than once - and one opened ready has no such note at all,
      # so its creation date is when it became reviewable. Anchored, because
      # an unanchored "ready" also matches "already" in a commit-list note.
      ready: ([ $mr.notes.nodes[]?
                | select(.system == true)
                | select(.body | test("^marked this merge request as \\*\\*ready\\*\\*$|^unmarked as a work in progress"; "i"))
                | .createdAt ] | sort | last // $mr.createdAt),

      approvers: [ $mr.approvedBy.nodes[]?.username ],
      commenters: [ $reviews[].author.username ]
    })

  # An MR up for re-review has been waiting since it was answered, not since
  # it first went ready - unless it went back to draft and was readied again
  # after that.
  | map(.since = ([.ready, .rereview_at] | max))
  | sort_by(.since)
  | .[]
  | [ .iid, .title, .webUrl, .since,
      (.approvers | length | tostring), names(.approvers),
      (.commenters | length | tostring), names(.commenters),
      (.conflicts | tostring), .rereview_at, .reviewed_kind, .reviewed_at,
      names(.reviewers) ]
  | @tsv
' <<<"$graph_json" | tr '\t' '\037')

if [ -z "$rows" ]; then
  echo "No open, non-draft merge requests authored by $author in $project_path." >&2
  exit 0
fi

# --- Helpers ----------------------------------------------------------------

# Seconds since an ISO 8601 UTC timestamp like 2026-08-27T17:00:47.872Z.
age_seconds() {
  local iso="${1%%.*}"     # drop fractional seconds
  iso="${iso%Z}"           # drop the trailing Z
  local then
  then=$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$iso" +%s 2>/dev/null) || return 1
  echo $(( $(date +%s) - then ))
}

plural() { [ "$1" -eq 1 ] && echo "$1 $2" || echo "$1 ${2}s"; }

# An hour is the finest unit on purpose. Anything more precise would make the
# message text change between two runs minutes apart, and the duplicate check
# below relies on an unchanged message meaning an unchanged situation.
human_age() {
  local secs="$1"
  if   [ "$secs" -lt 3600 ];    then echo "less than an hour"
  elif [ "$secs" -lt 86400 ];   then plural $(( secs / 3600 )) hour
  elif [ "$secs" -lt 1209600 ]; then plural $(( secs / 86400 )) day
  else                               plural $(( secs / 604800 )) week
  fi
}

# Past messages that mentioned this MR, oldest first.
#
# One history file is one post, so this lists *files* rather than counting
# occurrences - a link named twice in a single message was still only posted
# once. Matching is on the host and path so a change of scheme still lines up,
# with a trailing non-digit boundary so !412 does not also match !4120.
mentions_of() {
  local url="$1"
  local needle="${url#*://}"
  local escaped
  escaped=$(printf '%s' "$needle" | sed 's/[.[\*^$()+?{}|\\]/\\&/g')

  # A missing history directory is the normal first-run case, not an error.
  grep -lE "${escaped}([^0-9]|\$)" "$history_dir"/*"$history_ext" 2>/dev/null | sort
}

# Strip the posted count so two messages can be compared on their substance.
#
# The count is guaranteed to differ between consecutive runs - the first
# message has no suffix, the second says "Posted here 1 time" - so comparing it
# would mean a repeat run never matched the one before it, which is the exact
# case this is meant to catch.
without_counts() {
  sed 's/ - Posted here [0-9][0-9]* times*$//'
}

# Ask whether an MR that already has review comments should still be chased.
#
# The prompt goes to stderr and the answer is read from the terminal rather
# than stdin: stdout has to stay clean for `mrpost | pbcopy`, and stdin is
# already spoken for by the loop that feeds this.
confirm_post() {
  local iid="$1" web_url="$2" count="$3" who="$4"
  local answer

  progress_clear

  echo "MR ${iid} has $(plural "$count" comment) from ${who} ${web_url}" >&2

  # Nobody to ask - keep the MR rather than silently shortening the message.
  if [ ! -e /dev/tty ] || ! { : >/dev/tty; } 2>/dev/null; then
    echo "Post anyway? y/N - no terminal to ask on, keeping it." >&2
    return 0
  fi

  printf 'Post anyway? y/N ' >&2
  read -r answer </dev/tty || answer=""
  case "$answer" in
    y|Y|yes|Yes|YES) return 0 ;;
    *) echo "Skipping !${iid}." >&2; return 1 ;;
  esac
}

# --- Build the message ------------------------------------------------------
message=""
approved_list=""
approved_count=0
conflicted_list=""
conflicted_count=0

while IFS=$'\037' read -r iid title web_url ready_at approval_count approvers comment_count commenters conflicts rereview_at reviewed_kind reviewed_at reviewers; do
  [ -n "$iid" ] || continue

  # Nobody can review what will not merge, so a conflicted MR is dropped and
  # reported instead. Checked before approvals on purpose: an approved MR that
  # has since gone stale needs a rebase, and saying so is more use than filing
  # it under "already done".
  if [ "$conflicts" = "true" ]; then
    conflicted_list+="  !${iid} ${web_url}"$'\n'
    conflicted_count=$(( conflicted_count + 1 ))
    continue
  fi

  # An approval is the clearest sign the MR has had its review, so it is
  # dropped outright rather than prompted about.
  if [ "${approval_count:-0}" -gt 0 ]; then
    approved_list+="  !${iid} approved by ${approvers} ${web_url}"$'\n'
    approved_count=$(( approved_count + 1 ))
    continue
  fi

  # Comments with a push since are a finished round, back with the reviewers.
  # Without one the next move is probably yours, so ask before chasing it.
  if [ -z "$assume_yes" ] && [ -z "$rereview_at" ] && [ "${comment_count:-0}" -gt 0 ]; then
    confirm_post "$iid" "$web_url" "$comment_count" "$commenters" || continue
  fi

  # An MR that has had a review round already is asked for a second look
  # rather than a first, with when that round was and who did it, so the
  # channel can see it is not starting from nothing.
  if [ -n "$rereview_at" ]; then
    status="Ready for re-review"
  else
    status="Ready for review"
  fi

  secs=$(age_seconds "$ready_at")
  if [ -n "$secs" ]; then
    detail="$status $(human_age "$secs") ago"
  else
    detail="$status $ready_at"
  fi

  if [ -n "$rereview_at" ]; then
    if [ "$reviewed_kind" = "approved" ]; then
      round="last approved"
    else
      round="last reviewed"
    fi
    reviewed_secs=$(age_seconds "$reviewed_at")
    if [ -n "$reviewed_secs" ]; then
      detail="$detail ($round $(human_age "$reviewed_secs") ago by $reviewers)"
    else
      detail="$detail ($round $reviewed_at by $reviewers)"
    fi
  fi

  # Opt-in: naming the count in the channel is a pointed thing to do, so it is
  # off unless asked for. History is still recorded either way, so turning the
  # flag on later reports every message that has already gone out.
  #
  # Counted before this run's own file is written, so an MR is never counted as
  # a mention of itself. Silent the first time an MR appears - there is nothing
  # to nag about yet; from the second message onwards the count is the point.
  if [ -n "$show_post_count" ]; then
    mention_files=$(mentions_of "$web_url")
    if [ -n "$mention_files" ]; then
      posted=$(printf '%s\n' "$mention_files" | wc -l | tr -d ' ')
      detail="$detail - Posted here $(plural "$posted" time)"
    fi
  fi

  message+="!${iid} — ${title}"$'\n'
  message+="${web_url}"$'\n'
  message+="${detail}"$'\n\n'
done <<<"$rows"

message="${message%$'\n\n'}"
progress_clear

# What was dropped for being approved. Goes to stderr, below the message, so it
# stays out of both the paste buffer and the saved history - it is a note to
# self about MRs that need no chasing, not something the channel needs.
report_approved() {
  [ "$approved_count" -gt 0 ] || return 0
  echo >&2
  echo "Dropped $(plural "$approved_count" "approved MR"):" >&2
  printf '%s' "$approved_list" >&2
}

# Reported after the approvals, so the MRs that need work from you are the
# last thing on screen.
report_conflicted() {
  [ "$conflicted_count" -gt 0 ] || return 0
  echo >&2
  echo "Skipped $(plural "$conflicted_count" "MR") with merge conflicts:" >&2
  printf '%s' "$conflicted_list" >&2
}

# Everything was declined - say so rather than emitting a blank message and
# recording it as a post that went to the channel.
if [ -z "$message" ]; then
  echo "Nothing to post." >&2
  report_approved
  report_conflicted
  exit 0
fi

printf '%s\n' "$message"

copy_to_clipboard "$message"

report_approved
report_conflicted

# --- Record this run --------------------------------------------------------
# Last, so the counts above reflect only earlier messages. A directory that
# cannot be created or written is worth a warning but not a failure: the
# message is already out, and losing the record beats losing the message.
if mkdir -p "$history_dir" 2>/dev/null; then
  previous=$(latest_history)

  # Running twice in a row with nothing changed is a slip, not a second post,
  # so it should not inflate the counts. Compared on substance rather than
  # byte-for-byte; see without_counts.
  if [ -n "$previous" ] && [ -r "$previous" ] \
     && [ "$(printf '%s\n' "$message" | without_counts)" \
        = "$(without_counts < "$previous")" ]; then
    echo "Same message as $(history_date "$previous") - not recording it again." >&2
  else
    history_file="$history_dir/$(date +%Y-%m-%d-%H%M%S)$history_ext"
    # The redirection is what fails on a read-only directory, and bash reports
    # that itself, so the whole group has to be muffled - not just printf.
    if ! { printf '%s\n' "$message" > "$history_file"; } 2>/dev/null; then
      echo "Could not write history file: $history_file" >&2
    fi
  fi
else
  echo "Could not create history directory: $history_dir" >&2
fi
